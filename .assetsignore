# Files that live in the repo but must NOT be served on the live site.
# (Cloudflare Workers/Pages static-assets honours this, gitignore-style.)

# version control + deploy tooling
.git
.github
.gitignore
.assetsignore
.wrangler
wrangler.jsonc
wrangler.toml
node_modules

# dev tooling, source data, and docs — not part of the playable site
tools/
data/
serve.js
*.bat
*.md
